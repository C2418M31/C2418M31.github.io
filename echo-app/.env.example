# Which AI provider powers /api/analyze, /api/chat, /api/query.
# Both providers can be configured at once; this just picks the active one.
AI_PROVIDER=gemini

# Gemini (used when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Claude (used when AI_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Public Mapbox token — exposed to the browser by design (NEXT_PUBLIC_ prefix),
# same as the current static site. Never put AI keys behind NEXT_PUBLIC_.
NEXT_PUBLIC_MAPBOX_TOKEN=
